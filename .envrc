watch_file .toolchain.env
watch_file pyproject.toml
watch_file uv.lock
dotenv .toolchain.env
if ! command -v uv >/dev/null 2>&1; then
  log_error "Install uv ${UV_VERSION}, then run direnv reload."
  return 1
fi
if [[ "$(uv --version | awk '{print $2}')" != "$UV_VERSION" ]]; then
  log_error "Paperflow requires uv ${UV_VERSION}; found $(uv --version)."
  return 1
fi
PATH_add "$UV_PROJECT_ENVIRONMENT/bin"
watch_file package-lock.json
